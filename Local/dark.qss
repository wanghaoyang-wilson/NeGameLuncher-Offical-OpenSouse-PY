<<<<<<< HEAD
/* 全局背景兜底 */
QStackedWidget {
    background-color: #121826 !important;
}
QWidget#page {
    background-color: #121826 !important;
}

QLabel {
    color: #94a3b8 !important;
    font-size: 13px !important;
}

QLabel#Main_Title {
    font-size: 24px !important;
    font-weight: 600 !important;
    letter-spacing: 3px !important;
    color: #cbd5e1 !important;
    padding: 12px 24px !important;
    border: 1px solid rgba(96, 165, 250, 0.18) !important;
    border-radius: 10px !important;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(40, 52, 70, 0.4),
        stop:1 rgba(22, 28, 40, 0.4)) !important;
    box-shadow:
        0 0 14px rgba(96, 165, 250, 0.15),
        inset 0 0 12px rgba(96, 165, 250, 0.06) !important;
}

QLineEdit#Main_ZhangHao_Input,
QLineEdit#Main_PassWord_Input {
    background-color: #1e293b !important;
    border: 1px solid rgba(71, 85, 105, 0.4) !important;
    border-radius: 7px !important;
    padding: 9px 12px !important;
    color: #e2e8f0 !important;
    font-size: 14px !important;
}
QLineEdit#Main_ZhangHao_Input:focus,
QLineEdit#Main_PassWord_Input:focus {
    border-color: #3b82f6 !important;
}

QPushButton#Main_Login_Button {
    background-color: #1d4ed8 !important;
    color: white !important;
    border: none !important;
    border-radius: 8px !important;
    font-size: 15px !important;
    font-weight: 500 !important;
}
QPushButton#Main_Login_Button:hover {
    background-color: #2563eb !important;
}
QPushButton#Main_Login_Button:pressed {
    background-color: #1e40af !important;
}

QPushButton#Main_instct_Button,
QPushButton#Main_Lost_Password {
    background: transparent !important;
    color: #94a3b8 !important;
    border: none !important;
    font-size: 12px !important;
}
QPushButton#Main_instct_Button:hover,
QPushButton#Main_Lost_Password:hover {
    color: #60a5fa !important;
    text-decoration: underline !important;
}

QPushButton#Main_OffLine_Run {
    background-color: #1a2233 !important;
    color: #cbd5e1 !important;
    border: 1px solid rgba(100, 116, 139, 0.35) !important;
    border-radius: 8px !important;
    font-size: 14px !important;
}
QPushButton#Main_OffLine_Run:hover {
    background-color: #232f44 !important;
}

QPushButton#Main_Exit_Button {
    background-color: #27272a !important;
    color: #a1a1aa !important;
    border: none !important;
    border-radius: 6px !important;
}
QPushButton#Main_Exit_Button:hover {
    background-color: #3f3f46 !important;
}

QCheckBox#remember {
    color: #94a3b8 !important;
}
QCheckBox#remember::indicator {
    width: 15px !important;
    height: 15px !important;
    border-radius: 4px !important;
    border: 1px solid #475569 !important;
    background-color: #1e293b !important;
}
QCheckBox#remember::indicator:checked {
    background-color: #2563eb !important;
    border-color: #3b82f6 !important;
}
